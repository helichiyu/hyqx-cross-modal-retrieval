# 复制为 .env 后修改；不要提交真实密码到仓库
# 数据库
CMR_DB_NAME=cmr
CMR_DB_USER=cmr
CMR_DB_PASSWORD=cmr-change-me
CMR_DB_ROOT_PASSWORD=root-change-me

# 安全密钥：生产必须替换（JWT 建议 ≥32 字节；AES 密钥内部经 SHA-256 派生，建议 ≥32 字节）
CMR_JWT_SECRET=change-me-jwt-secret-at-least-32-bytes
CMR_CRYPTO_KEY=change-me-crypto-key-32-bytes-0001

# 对外访问端口（前端 nginx）
CMR_WEB_PORT=8080

# 模型权重目录（宿主机绝对或相对本目录的路径；其下需有 chinese-clip-vit-base-patch16 / clap-htsat-fused / bge-reranker-v2-m3）
CMR_WEIGHT_DIR=../weight

# 后端 JVM 参数
CMR_JAVA_OPTS=-Xms512m -Xmx2g
