# 复制为 .env 后按环境填写；敏感值不要提交到仓库
CMR_SERVER_IMAGE=hsmty-module-cmr-start:latest
CMR_WEB_IMAGE=hsmty-cmr-web:latest
CMR_SERVER_PORT=8080
CMR_WEB_PORT=8081

# UAP 校验与登录跳转地址（向平台申请）
HSMTY_VERIFY_URL=https://obu-ai-cloud.corp.huxishenghuo.com/hs-api/permissions/verify
HSMTY_REDIRECT_URL=https://obu-ai-cloud.corp.huxishenghuo.com/sdom-main-web/home

# 本服务对外地址（Feign 使用，含 context-path）
CMR_SERVICE_URL=http://cmr-server:8080/hs-api

# 文件存储：s3 指向 OSS/MinIO
CMR_FILE_STORE=s3
CMR_FILE_BUCKET=
CMR_FILE_ENDPOINT=
CMR_FILE_ACCESS_KEY=
CMR_FILE_SECRET_KEY=

# Jasypt 主密码（生产通过密钥管理注入，禁止使用模板默认值）
JASYPT_ENCRYPTOR_PASSWORD=
