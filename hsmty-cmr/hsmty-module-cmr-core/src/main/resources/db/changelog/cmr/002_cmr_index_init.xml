<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="cmr-create-index-20261111" author="cmr" context="mysql,postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="cmr_index"/>
            </not>
        </preConditions>

        <createTable tableName="cmr_index" remarks="索引">
            <column name="id" type="BIGINT" remarks="雪花主键">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_cmr_index"/>
            </column>
            <column name="dataset_id" type="BIGINT" remarks="所属数据集"/>
            <column name="index_dir" type="VARCHAR(256)" remarks="逻辑目录">
                <constraints nullable="false"/>
            </column>
            <column name="model_version" type="VARCHAR(32)" remarks="向量模型版本"/>
            <column name="status" type="VARCHAR(16)" defaultValue="candidate" remarks="状态：candidate/active/retired">
                <constraints nullable="false"/>
            </column>
            <column name="counts_json" type="JSON" remarks="分模态条数"/>
            <column name="check_result_json" type="JSON" remarks="投产校验结果"/>
            <column name="activated_time" type="DATETIME" remarks="激活时间"/>
            <column name="create_id" type="BIGINT" remarks="创建人"/>
            <column name="create_time" type="DATETIME" remarks="创建时间"/>
            <column name="update_id" type="BIGINT" remarks="更新人"/>
            <column name="update_time" type="DATETIME" remarks="更新时间"/>
            <column name="del_flag" type="CHAR(1)" defaultValue="F" remarks="逻辑删除：F 正常，T 删除">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="cmr_index" indexName="uk_cmr_index_index_dir" unique="true">
            <column name="index_dir"/>
        </createIndex>
        <createIndex tableName="cmr_index" indexName="idx_cmr_index_status">
            <column name="status"/>
            <column name="activated_time"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
