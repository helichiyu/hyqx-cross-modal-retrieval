<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="cmr-create-result-item-20261111" author="cmr" context="mysql,postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="cmr_result_item"/>
            </not>
        </preConditions>

        <createTable tableName="cmr_result_item" remarks="结果集条目（ID 快照）">
            <column name="id" type="BIGINT" remarks="雪花主键">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_cmr_result_item"/>
            </column>
            <column name="search_id" type="BIGINT" remarks="检索历史 ID">
                <constraints nullable="false"/>
            </column>
            <column name="result_set_id" type="VARCHAR(40)" remarks="冗余 RST 结果集编号">
                <constraints nullable="false"/>
            </column>
            <column name="result_rank" type="INT" remarks="名次">
                <constraints nullable="false"/>
            </column>
            <column name="item_id" type="VARCHAR(64)" remarks="算子条目 ID">
                <constraints nullable="false"/>
            </column>
            <column name="item_name" type="VARCHAR(512)" remarks="条目名称快照"/>
            <column name="source" type="VARCHAR(256)" remarks="来源名快照"/>
            <column name="modality" type="VARCHAR(16)" remarks="模态"/>
            <column name="score" type="DECIMAL(10,6)" remarks="融合分"/>
            <column name="align_score" type="DECIMAL(10,6)" remarks="对齐分"/>
            <column name="quality_grade" type="CHAR(1)" remarks="质量等级 A/B/C/D"/>
            <column name="clicked" type="TINYINT(1)" defaultValue="0" remarks="是否被点击">
                <constraints nullable="false"/>
            </column>
            <column name="create_id" type="BIGINT" remarks="创建人"/>
            <column name="create_time" type="DATETIME" remarks="创建时间"/>
            <column name="update_id" type="BIGINT" remarks="更新人"/>
            <column name="update_time" type="DATETIME" remarks="更新时间"/>
            <column name="del_flag" type="CHAR(1)" defaultValue="F" remarks="逻辑删除：F 正常，T 删除">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="cmr_result_item" indexName="idx_cmr_result_item_search_id">
            <column name="search_id"/>
        </createIndex>
        <createIndex tableName="cmr_result_item" indexName="idx_cmr_result_item_result_set_id">
            <column name="result_set_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
