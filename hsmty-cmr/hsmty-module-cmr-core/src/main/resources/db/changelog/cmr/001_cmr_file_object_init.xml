<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="cmr-create-file-object-20261110" author="cmr" context="mysql,postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="cmr_file_object"/>
            </not>
        </preConditions>

        <createTable tableName="cmr_file_object" remarks="文件对象元数据">
            <column name="id" type="BIGINT" remarks="雪花主键">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_cmr_file_object"/>
            </column>
            <column name="biz_no" type="VARCHAR(64)" remarks="业务编号">
                <constraints nullable="false"/>
            </column>
            <column name="biz_type" type="VARCHAR(64)" remarks="业务类型"/>
            <column name="bucket" type="VARCHAR(128)" remarks="桶"/>
            <column name="object_key" type="VARCHAR(512)" remarks="对象键">
                <constraints nullable="false"/>
            </column>
            <column name="original_name" type="VARCHAR(255)" remarks="原始文件名"/>
            <column name="content_type" type="VARCHAR(128)" remarks="MIME 类型"/>
            <column name="size" type="BIGINT" remarks="字节数"/>
            <column name="sha256" type="CHAR(64)" remarks="SHA-256 摘要"/>
            <column name="store_type" type="VARCHAR(16)" remarks="存储类型：local/s3"/>
            <column name="status" type="VARCHAR(20)" defaultValue="active" remarks="状态">
                <constraints nullable="false"/>
            </column>
            <column name="create_id" type="BIGINT" remarks="创建人"/>
            <column name="create_time" type="DATETIME" remarks="创建时间"/>
            <column name="update_id" type="BIGINT" remarks="更新人"/>
            <column name="update_time" type="DATETIME" remarks="更新时间"/>
            <column name="del_flag" type="CHAR(1)" defaultValue="F" remarks="逻辑删除：F 正常，T 删除">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="cmr_file_object" indexName="uk_cmr_file_object_biz_no" unique="true">
            <column name="biz_no"/>
        </createIndex>
        <createIndex tableName="cmr_file_object" indexName="idx_cmr_file_object_create_time">
            <column name="create_time"/>
        </createIndex>
        <!-- 列表查询为 status 等值 + create_time 倒序，按最左前缀建组合索引 -->
        <createIndex tableName="cmr_file_object" indexName="idx_cmr_file_object_status_create_time">
            <column name="status"/>
            <column name="create_time"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
